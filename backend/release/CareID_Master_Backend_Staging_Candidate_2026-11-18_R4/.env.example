# ==============================================================================
# CareID Backend (HVAPI) — Local Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env      (Linux/macOS)
#      copy .env.example .env    (Windows PowerShell / CMD)
# 2. Fill in the values appropriate for your local development environment.
# 3. DO NOT commit '.env' containing real secrets or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration (CURRENT — ACTUALLY CONSUMED BY CODE)
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'staging' | 'production'
# Enforced by: src/config/env.validation.ts (IsEnum)
NODE_ENV=development

# Server listening port
# Enforced by: src/config/env.validation.ts (IsNumber), consumed by src/main.ts
PORT=3073

# Server binding host (e.g., '127.0.0.1' or '0.0.0.0')
# In production, defaults to '127.0.0.1' (loopback) to prevent direct public network exposure.
# In development, defaults to '0.0.0.0'.
HOST=127.0.0.1

# Express reverse proxy trust configuration (DEP-01 Hardening)
# Allowed: 'loopback', specific IP(s) ('127.0.0.1', '::1'), or narrow host CIDRs (/28 to /32).
# Rejected for safety: 'true', '*', 'all', numeric hop counts ('1', '2'), and broad CIDR subnets.
# Defaults strictly to 'loopback' when unset or if an unsafe value is provided.
TRUST_PROXY=loopback

# API base prefix (e.g., 'api' produces /api/v1/...)
# Enforced by: src/config/env.validation.ts (IsString), consumed by src/main.ts
# NOTE: docs previously referenced 'API_PREFIX', but source code reads 'GLOBAL_PREFIX'.
GLOBAL_PREFIX=api

# OpenAPI Swagger documentation route path (e.g., 'docs' produces /docs)
# Consumed by: src/main.ts (defaults to 'docs')
SWAGGER_PATH=docs

# Logging level: 'trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal'
# Consumed by: PinoLoggerModule in src/app.module.ts (defaults to 'info')
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection (CURRENT — ACTUALLY CONSUMED BY CODE)
# ------------------------------------------------------------------------------
# CAUTION: Always use a dedicated local development database.
# Never point your local environment to the production database.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=<schema>
# Enforced by: src/config/env.validation.ts (IsString), consumed by src/database/database.service.ts
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/careid_dev?schema=public"

# PostgreSQL Connection Pool Settings (per PM2 worker process)
# In PM2 cluster mode ('instances: max'), each worker process instantiates its own pool.
# Total connections to PostgreSQL = (number of PM2 workers) * DB_POOL_MAX.
# Ensure PostgreSQL server 'max_connections' is sized appropriately to avoid pool exhaustion.
# Defaults: DB_POOL_MAX=10 (clamped 1-100), DB_CONNECTION_TIMEOUT_MS=5000, DB_IDLE_TIMEOUT_MS=10000
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=10000

# PostgreSQL TLS / SSL Configuration
# Set DATABASE_SSL=true when connecting to managed cloud PostgreSQL (e.g. AWS RDS, GCP Cloud SQL).
# Defaults: DATABASE_SSL=false, DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Tokens (CURRENT — ACTUALLY CONSUMED BY CODE)
# ------------------------------------------------------------------------------
# Secret key used for signing & verifying both Access and Refresh JWT tokens
# Consumed by: src/modules/auth/auth.module.ts, jwt.strategy.ts, auth.service.ts
# WARNING: In production, this must be a cryptographically strong secret (min 64 chars).
JWT_SECRET=local_development_jwt_secret_min_64_characters_long_for_security_testing_only

# Access token lifespan (e.g., '15m', '1h')
# Consumed by: src/modules/auth/auth.module.ts, auth.service.ts (defaults to '15m')
JWT_EXPIRATION=15m

# Refresh token lifespan (e.g., '7d', '30d')
# Consumed by: src/modules/auth/application/use-cases/auth.service.ts (defaults to '7d')
# NOTE: docs previously referenced 'JWT_REFRESH_EXPIRATION', but source code reads 'REFRESH_TOKEN_EXPIRATION'.
REFRESH_TOKEN_EXPIRATION=7d

# HMAC secret for Patient QR code generation and cryptographic integrity verification
# Consumed by: src/modules/qr/application/use-cases/qr.service.ts
QR_HMAC_SECRET=local_qr_hmac_secret_key_for_development_purposes_only

# ------------------------------------------------------------------------------
# 4. Controlled Security & Development Testing (PLANNED REMEDIATION)
# ------------------------------------------------------------------------------
# Controls whether whitelisted test phone numbers can bypass SMS delivery in development.
# STRICT CODE GUARD: This test bypass is unconditionally rejected if NODE_ENV=production.
ENABLE_TEST_OTP=false

# Comma-separated list of E.164 phone numbers allowed to use TEST_OTP_CODE (dev only).
# Local Development Seed Accounts:
#   +16505550001 (Super Admin)
#   +16505550002 (System Admin)
#   +16505550003 (Doctor / Practitioner)
#   +16505550004 (Patient)
#   +16505550005 (Facility Admin)
#   +16505550006 (Staff Nurse)
#   +16505550007 (Family Member)
TEST_PHONE_NUMBERS="+16505550001,+16505550002,+16505550003,+16505550004,+16505550005,+16505550006,+16505550007"

# Static OTP code returned exclusively for whitelisted numbers in non-production environments
TEST_OTP_CODE=123456

# ------------------------------------------------------------------------------
# 5. Brevo Transactional Email Service (PLANNED INTEGRATION)
# ------------------------------------------------------------------------------
# API Key for Brevo (formerly Sendinblue) Transactional REST API v3
# Planned consumption by: src/modules/auth/infrastructure/services/brevo-email.service.ts
BREVO_API_KEY=xkeysib-local-development-placeholder-key-do-not-use

# Verified sender email address configured in Brevo account settings
BREVO_SENDER_EMAIL=auth@careid.vnvision.in

# Display name for outbound verification and OTP emails
BREVO_SENDER_NAME="CareID Health Security"

# ------------------------------------------------------------------------------
# 6. Firebase Admin SDK Phone Verification (PLANNED INTEGRATION)
# ------------------------------------------------------------------------------
# Target Firebase project identifier (corresponds to Android/Web client config)
# Planned consumption by: src/modules/auth/infrastructure/services/firebase-auth.service.ts
FIREBASE_PROJECT_ID=careid-5e423

# Service account client email (generated in GCP / Firebase Console Service Accounts)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-careid@careid-5e423.iam.gserviceaccount.com

# Service account RSA private key (replace with your Firebase service account private key).
FIREBASE_PRIVATE_KEY="<REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY>"

# ------------------------------------------------------------------------------
# 7. Durable Identity Mapping & Throttling Store (PLANNED INTEGRATION)
# ------------------------------------------------------------------------------
# Redis or Valkey connection URI for durable email-to-userId mapping,
# multi-process PM2 cluster session synchronization, and sliding-window rate-limiting.
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 8. Backblaze B2 Private Document Storage (PLANNED STORAGE INTEGRATION)
# ------------------------------------------------------------------------------
# Dedicated private Backblaze B2 bucket for CareID patient medical attachments and reports.
# Must NOT reuse credentials or buckets from any other project.
# Planned consumption by: src/modules/storage/infrastructure/b2-storage.service.ts

# S3-compatible Backblaze B2 regional endpoint (e.g., https://s3.us-east-005.backblazeb2.com)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# S3 storage region corresponding to the Backblaze B2 cluster
B2_REGION=us-east-005

# Dedicated private bucket name (strictly private, zero public access)
B2_BUCKET_NAME=careid-patient-docs-dev

# Backblaze B2 Application Key ID (keyID)
B2_KEY_ID=005localdevkeyidplaceholder

# Backblaze B2 Application Key (applicationKey secret)
B2_APPLICATION_KEY=K005localdevapplicationkeyplaceholder

# Pre-signed download URL expiration time in seconds (defaults to 900s / 15 minutes, range: 60-3600)
# Consumed by: src/modules/storage/infrastructure/b2-storage.service.ts
B2_DOWNLOAD_EXPIRY_SECONDS=900

# ------------------------------------------------------------------------------
# 9. Persistent PaddleOCR Worker Service (CareID OCR Pipeline)
# ------------------------------------------------------------------------------
# HTTP URL for the persistent Python PaddleOCR worker daemon (services/ocr-worker)
# Consumed by: src/modules/ocr/infrastructure/clients/ocr-worker.client.ts
CAREID_OCR_WORKER_URL=http://127.0.0.1:5050

# Internal shared secret for authenticating requests between NestJS and the Python OCR worker.
# Must be set to a cryptographically strong random token (min 32 characters).
# Consumed by: NestJS (X-CareID-Internal-Secret header) and Python worker (config.py).
CAREID_OCR_SECRET=replace_with_a_secure_random_ocr_worker_secret_minimum_32_chars

# Timeout for OCR extraction requests in milliseconds (defaults to 180000ms / 3 minutes)
CAREID_OCR_TIMEOUT_MS=180000

# ------------------------------------------------------------------------------
# 10. Healthcare Financing Field-Level Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# 256-bit symmetric encryption key encoded as a 64-character hexadecimal string.
# Used for encrypting sensitive underwriting data (e.g., PAN/National ID, Monthly Income) at rest.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Consumed by: src/modules/financing/infrastructure/security/financing-crypto.service.ts
FINANCING_ENCRYPTION_KEY=replace_with_a_secure_64_character_hex_encryption_key

