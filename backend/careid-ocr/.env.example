# ==============================================================================
# CareID Standalone OCR Microservice — Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# ==============================================================================

# Server Binding
CAREID_OCR_HOST=0.0.0.0
CAREID_OCR_PORT=5050

# Shared Internal Secret for Authentication (MUST match CAREID_OCR_SECRET in Main Backend)
# Generate a strong 64-character random hex string: openssl rand -hex 32
CAREID_OCR_SECRET=replace-with-strong-internal-shared-secret-minimum-32-chars

# Concurrency & Resource Limits
CAREID_OCR_MAX_CONCURRENCY=2
CAREID_OCR_TIMEOUT_SECONDS=180
CAREID_OCR_MAX_FILE_SIZE_MB=50
CAREID_OCR_MAX_PAGES=50
CAREID_OCR_CPU_THREADS=4

# OCR Engine Tuning
CAREID_OCR_ENGINE_VERSION=PP-OCRv4
CAREID_OCR_LANG=en
CAREID_OCR_PDF_DPI=150
CAREID_OCR_DET_THRESH=0.2
CAREID_OCR_BOX_THRESH=0.4
CAREID_OCR_REC_BATCH_SIZE=6

# Storage Paths
CAREID_OCR_TEMP_DIR=/opt/careid-ocr/tmp

# Paddle Hardware Flags (CPU Deployment)
FLAGS_use_mkldnn=0
PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=0
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLE_PDX_CPU_NUM_THREADS=4

